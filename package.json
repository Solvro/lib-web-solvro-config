{
  "name": "@solvro/config",
  "version": "4.0.0-beta.2",
  "description": "Solvro's engineering style guide",
  "keywords": [
    "eslint",
    "prettier",
    "solvro"
  ],
  "homepage": "https://github.com/Solvro/lib-web-solvro-config#readme",
  "bugs": {
    "url": "https://github.com/Solvro/lib-web-solvro-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solvro/lib-web-solvro-config.git"
  },
  "license": "MPL-2.0",
  "type": "module",
  "exports": {
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "import": "./dist/eslint/index.js",
      "require": "./dist/eslint/index.cjs"
    },
    "./prettier": {
      "types": "./dist/prettier/index.d.ts",
      "import": "./dist/prettier/index.js",
      "require": "./dist/prettier/index.cjs"
    },
    "./commitlint": {
      "types": "./dist/commitlint/index.d.ts",
      "import": "./dist/commitlint/index.js",
      "require": "./dist/commitlint/index.cjs"
    }
  },
  "bin": {
    "config": "bin/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "cli": "tsx ./src/cli/index.ts",
    "dev": "npx @eslint/config-inspector",
    "format": "prettier --check .",
    "knip": "knip",
    "lint": "eslint .",
    "prepack": "npm run build",
    "prepare": "husky || true",
    "release": "semantic-release",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit"
  },
  "lint-staged": {
    "*": "prettier -w --ignore-unknown"
  },
  "prettier": "./dist/prettier/index.js",
  "overrides": {
    "@typescript-eslint/parser": "^8.67.0",
    "conventional-changelog-writer": "^9.2.1",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "@adonisjs/eslint-config": "^3.1.0",
    "@clack/prompts": "^1.7.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@darraghor/eslint-plugin-nestjs-typed": "^7.3.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^10.0.1",
    "@nelsonlaidev/eslint-plugin": "^0.2.5",
    "@solvro/utils": "^1.6.0",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "commander": "^15.0.0",
    "eslint-config-flat-gitignore": "^2.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-antfu": "^3.2.3",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-zod": "^4.9.1",
    "execa": "^10.0.1",
    "find-up-simple": "^1.0.1",
    "globals": "^17.11.0",
    "is-interactive": "^2.0.0",
    "local-pkg": "^1.2.1",
    "package-manager-detector": "^1.8.0",
    "picocolors": "^1.1.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semver": "^7.8.5",
    "typescript-eslint": "~8.68.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/types": "^21.1.0",
    "@eslint/config-inspector": "^3.3.0",
    "@next/eslint-plugin-next": "^16.3.1",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/utils": "^8.67.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "pkg-pr-new": "^0.0.88",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@next/eslint-plugin-next": ">=12.3.0",
    "eslint": "^10.4.0"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": "^10.9.8 || ^11.11.1 || >=12.0.2"
  },
  "volta": {
    "node": "24.19.0",
    "npm": "12.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "unrs-resolver": false
  }
}
